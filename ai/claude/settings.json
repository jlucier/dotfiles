{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "PushNotification",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "disableBundledSkills": true,
    "disableWorkflows": true,
    "disableArtifact": true
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "outputStyle": "Simplified Technical English",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "editorMode": "vim",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": false,
    "pr": false,
    "sessionUrl": false
  }
}
