[Unit]
Description=Daily meeting-to-task follow-up reconciliation

[Timer]
# Fire daily at ~03:30 local, before the daily brief (04:00) so the brief can
# pick up the follow-up cards this job just created.
OnCalendar=*-*-* 03:30:00
# Spread the wake-up a little so it doesn't fight other jobs.
RandomizedDelaySec=5min
# Catch up on a run missed while the machine was asleep/off.
Persistent=true

[Install]
WantedBy=timers.target
